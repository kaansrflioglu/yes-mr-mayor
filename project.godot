; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="yes-mr-mayor"
run/main_scene="res://scenes/menu/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/GameManager.gd"
EventManager="*res://scripts/autoload/EventManager.gd"
LocalizationManager="*res://scripts/autoload/LocalizationManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
TwitchManager="*res://scripts/autoload/TwitchManager.gd"
SettingsManager="*res://scripts/autoload/SettingsManager.gd"
SaveLoadManager="*res://scripts/autoload/SaveLoadManager.gd"
DirectiveManager="*res://scripts/autoload/DirectiveManager.gd"
FactionManager="*res://scripts/autoload/FactionManager.gd"
ElectionManager="*res://scripts/autoload/ElectionManager.gd"
EndingsManager="*res://scripts/autoload/EndingsManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://resources/themes/mayoral_theme.tres"
theme/custom_font="res://assets/fonts/Inter-Medium.ttf"

